		{
			"name": "站会问答 - 正常查询",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has correct structure\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('code');",
							"    pm.expect(jsonData).to.have.property('message');",
							"    pm.expect(jsonData).to.have.property('traceId');",
							"    pm.expect(jsonData).to.have.property('data');",
							"});",
							"",
							"pm.test(\"Response code is OK\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.code).to.eql('OK');",
							"});",
							"",
							"pm.test(\"Data has answer field\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data).to.have.property('answer');",
							"    pm.expect(jsonData.data.answer).to.be.a('string');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"question\": \"当前项目的进度怎么样？\",\n    \"projectId\": 1,\n    \"sprintId\": 1,\n    \"timezone\": \"Asia/Shanghai\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/agent/standup/query",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"agent",
						"standup",
						"query"
					]
				},
				"description": "测试正常的站会问答查询"
			},
			"response": []
		},
